# ============================================================
# LeitorDeDocs — Configuração
# ============================================================
# Copie este arquivo para .env e ajuste conforme necessário.
# ============================================================

# Provedor ativo: ollama | gemini | groq
AI_PROVIDER=ollama

# ------------------------------------------------------------
# Ollama — Llama local (padrão, sem internet, sem custo)
# ------------------------------------------------------------
# 1. Instale o Ollama: https://ollama.com
# 2. Baixe o modelo de visão:
#       ollama pull llama3.2-vision
# 3. O servidor Ollama deve estar em execução (ollama serve)
#
# Outros modelos de visão compatíveis:
#   ollama pull llava           (alternativa leve)
#   ollama pull minicpm-v       (alternativa compacta)
# ------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision

# ------------------------------------------------------------
# Gemini (Google) — alternativa na nuvem
# Obtenha sua chave em: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------
# AI_PROVIDER=gemini
# GEMINI_API_KEY=

# ------------------------------------------------------------
# Groq (Llama na nuvem) — alternativa gratuita na nuvem
# Obtenha sua chave em: https://console.groq.com
# ------------------------------------------------------------
# AI_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.2-11b-vision-preview
