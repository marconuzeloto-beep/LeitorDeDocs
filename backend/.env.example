# ============================================================
# LeitorDeDocs — Configuração do Ollama
# ============================================================
# Copie este arquivo para .env e ajuste se necessário.
#
# Pré-requisitos:
#   1. Instale o Ollama: https://ollama.com
#   2. Baixe o modelo:   ollama pull llama3.2-vision
#   3. Inicie o serviço: ollama serve  (ou deixe rodar em segundo plano)
# ============================================================

# URL do servidor Ollama (padrão: localhost)
OLLAMA_BASE_URL=http://localhost:11434

# Modelo de visão a utilizar
# Opções testadas: llama3.2-vision | llava | minicpm-v
OLLAMA_MODEL=llama3.2-vision
